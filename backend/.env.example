# ---- required ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/futureminds
JWT_SECRET=change-me-to-a-long-random-string      # e.g. run: openssl rand -hex 32

# ---- AI tutor (free key: https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash                      # swap for a newer Flash id any time

# ---- video / file storage ----
# Leave S3_BUCKET empty in local dev: files are saved to backend/uploads instead.
# On Railway, point these at your Bucket's variables (see README).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false                          # set true if uploads fail with signature/host errors
MAX_UPLOAD_MB=300

# ---- misc ----
PORT=3001
SEED_PASSWORD=password123                          # password for the 4 demo accounts on first boot
AUTO_SEED=true                                     # create demo users + course on an empty database
CORS_ORIGIN=http://localhost:5173                  # only needed when frontend is on another origin (vite dev)
DATABASE_SSL=false                                 # true for Railway's *public* Postgres URL
